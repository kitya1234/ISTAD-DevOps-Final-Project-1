version: '3.8'

services:
  sonarqube:
    image: {{ sonarqube_image }}
    container_name: sonarqube
    restart: unless-stopped
    depends_on:
      - db
    ports:
      - "127.0.0.1:{{ sonarqube_service_port }}:9000"
    environment:
      - SONAR_JDBC_USERNAME={{ sonar_db_user }}
      - SONAR_JDBC_PASSWORD={{ sonar_db_password }}
      - SONAR_JDBC_URL=jdbc:postgresql://db:5432/{{ sonar_db_name }}
    volumes:
      - {{ sonarqube_dir }}/data:/opt/sonarqube/data
      - {{ sonarqube_dir }}/extensions:/opt/sonarqube/extensions
      - {{ sonarqube_dir }}/logs:/opt/sonarqube/logs
    ulimits:
      nofile:
        soft: 65536
        hard: 65536

  db:
    image: {{ postgres_image }}
    container_name: sonarqube_db
    restart: unless-stopped
    environment:
      - POSTGRES_USER={{ sonar_db_user }}
      - POSTGRES_PASSWORD={{ sonar_db_password }}
      - POSTGRES_DB={{ sonar_db_name }}
    volumes:
      - {{ sonarqube_dir }}/postgres_data:/var/lib/postgresql/data
