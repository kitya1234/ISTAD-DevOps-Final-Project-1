version: '3.8'

services:
  nexus:
    image: {{ nexus_image }}
    container_name: nexus
    restart: unless-stopped
    user: "200:200"
    ports:
      - "127.0.0.1:{{ nexus_service_port }}:8081"
    volumes:
      - {{ nexus_data_dir }}:/nexus-data
    environment:
      - INSTALL4J_ADD_VM_PARAMS=-Xms1200m -Xmx1200m -XX:MaxDirectMemorySize=2048m
