# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"
  config.vm.box_check_update = false

  machines = [
    { name: "machine01", ip: "192.168.56.11", memory: 2048, cpus: 2 },
    { name: "machine02", ip: "192.168.56.12", memory: 3072, cpus: 2 },
    { name: "machine03", ip: "192.168.56.13", memory: 3072, cpus: 2 }
  ]

  machines.each do |m|
    config.vm.define m[:name] do |node|
      node.vm.hostname = m[:name]
      node.vm.network "private_network", ip: m[:ip]
      node.vm.provider "virtualbox" do |vb|
        vb.name = m[:name]
        vb.memory = m[:memory]
        vb.cpus = m[:cpus]
      end
      # Enable passwordless sudo for user 'vagrant'
      node.vm.provision "shell", inline: <<-SHELL
        sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config
        systemctl restart sshd
      SHELL
    end
  end
end
